# Published only on localhost by default. Change to 0.0.0.0 for external access.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Enable only when the trusted proxy overwrites CF-IPCountry.
TRUST_COUNTRY_HEADER=false
# IP address or CIDR of the reverse proxy that supplies forwarded headers.
FORWARDED_ALLOW_IPS=127.0.0.1
